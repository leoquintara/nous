# Base de datos (PostgreSQL + pgvector, ver docker-compose.yml)
NOUS_DATABASE_URL=postgresql+asyncpg://nous:nous@localhost:5432/nous

# Embeddings — local-first por defecto. Cambiar a 'external' requiere
# consentimiento explícito del usuario (los datos saldrían de la máquina).
NOUS_EMBEDDING_PROVIDER=local
NOUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2

# Reranker local (cross-encoder en CPU) y decaimiento por recencia
NOUS_RERANKER_HABILITADO=true
NOUS_RERANKER_MODELO=cross-encoder/ms-marco-MiniLM-L12-v2
NOUS_RECENCIA_VIDA_MEDIA_DIAS=30

# Transporte MCP: stdio | http
NOUS_MCP_TRANSPORT=stdio
# Token Bearer para proteger el transporte HTTP y la API REST.
# Formato obligatorio: prefijo 'ns_' + 64 caracteres hex.
# Vacío = modo desarrollo local sin autenticación (NO usar en red).
# Genera uno con: python -c "import secrets; print('ns_' + secrets.token_hex(32))"
NOUS_API_TOKEN=

# API REST / web
NOUS_API_HOST=127.0.0.1
NOUS_API_PORT=8720

NOUS_LOG_LEVEL=INFO
