# Base de datos (PostgreSQL + pgvector, ver docker-compose.yml)
NOUS_DATABASE_URL=postgresql+asyncpg://nous:nous@localhost:5432/nous
# Opcional — PostgreSQL existente fuera del stack compose.
# Si se define, el contenedor `nous-db` no es necesario: arranca la
# app con `docker compose up -d --no-deps app` para no levantarlo
# (`depends_on: db` en compose es la ruta por defecto, no requerida).
# NOUS_DATABASE_URL_DOCKER=postgresql+asyncpg://nous:nous@host.docker.internal:5433/nous
# Durabilidad del commit (default false = asynchronous_commit):
# el commit no espera el fsync del WAL; ante un crash de PostgreSQL se
# arriesgan ~0.5s de escrituras (mismo trade-off que los memory stores
# comparables). 'true' fuerza fsync por commit (más lento, más seguro).
NOUS_COMMIT_SINCRONO=false

# Embeddings — local-first por defecto. Cambiar a 'external' requiere
# consentimiento explícito del usuario (los datos saldrían de la máquina).
NOUS_EMBEDDING_PROVIDER=local
NOUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2
# Backend de inferencia: auto (default, usa onnxruntime si está
# disponible ~3x más rápido) | onnx (estricto) | torch.
NOUS_EMBEDDINGS_BACKEND=auto
# Offline estricto de HuggingFace (default true): Nous nunca contacta
# huggingface.co en runtime con la caché poblada. Si los modelos aún no
# existen en caché (primer arranque), se permite la descarga inicial y
# el offline estricto se reactiva solo en el siguiente arranque.
NOUS_HF_OFFLINE=true
# Warm-up de modelos al arrancar (default true): añade ~15-40s al
# inicio pero las tools responden en ~1s después. Desactivar si el
# cliente MCP tiene un timeout de spawn muy corto.
NOUS_PRECALENTAR_MODELOS=true

# Reranker local (cross-encoder en CPU) y decaimiento por recencia
NOUS_RERANKER_HABILITADO=true
NOUS_RERANKER_MODELO=cross-encoder/ms-marco-MiniLM-L12-v2
# Candidatos que paga el reranker por consulta (un forward pass
# c/u). En hardware modesto bajar a 6 recorta el p95 del recall.
NOUS_RERANKER_CANDIDATOS=10
NOUS_RECENCIA_VIDA_MEDIA_DIAS=30

# Transporte MCP: stdio | http
NOUS_MCP_TRANSPORT=stdio
# Token Bearer para proteger el transporte HTTP y la API REST.
# Formato obligatorio: prefijo 'ns_' + 64 caracteres hex.
# Vacío = modo desarrollo local sin autenticación (NO usar en red).
# Genera uno con: python -c "import secrets; print('ns_' + secrets.token_hex(32))"
NOUS_API_TOKEN=

# API REST / web
NOUS_API_HOST=127.0.0.1
NOUS_API_PORT=8720
# Orígenes CORS permitidos para el dashboard (separados por coma).
# Añade el origen donde sirvas el dashboard si no es :3000.
NOUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NOUS_LOG_LEVEL=INFO

# Login alternativo del dashboard (opcional): si se configuran, /api/login
# acepta usuario+contraseña y devuelve el token de servicio.
# NOUS_DASHBOARD_USUARIO=admin
# NOUS_DASHBOARD_PASSWORD=cambia-esto

# Multi-tenant: key de usuario para el proceso stdio (opcional).
# Sin ella, el proceso actúa como el owner local.
# NOUS_API_KEY=ns_u_...

# Licencia comercial (opcional): desbloquea el multi-tenant completo.
# Sin ella la edición libre self-hosted queda limitada a:
#   1 usuario y 3 workspaces.
# Alternativa a `nous activate-license <key>` (guarda en ~/.nous/license.jwt).
# NOUS_LICENSE_KEY=
# PEM para verificar la firma RS256 del JWT (opcional — sin ella, honor).
# NOUS_LICENSE_PUBLIC_KEY=
# Servicio de activación de Quintara — canjea seriales por JWT firmado.
# NOUS_LICENSE_ACTIVATION_URL=
# NOUS_MAX_USUARIOS_LIBRES=1
# NOUS_MAX_WORKSPACES_LIBRES=3

# Neuro-5 — presupuesto del tier curado en caracteres (overflow-pressure).
# Curar una memoria que exceda el presupuesto exige consolidar antes.
# NOUS_CURADO_MAX_CHARS=8192

# Neuro-5 — aprobación pre-escritura: toda escritura llega staged
# (invisible al recall) hasta aprobar_evento / aprobar_pendientes.
# NOUS_ESCRITURA_APROBACION=false
